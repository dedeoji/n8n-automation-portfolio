    },
    {
      "parameters": {
        "jsCode": "// read the uploaded markdown file\nconst item = $input.first();\nconst key = Object.keys(item.binary)[0];\nconst buffer = await this.helpers.getBinaryDataBuffer(0, key);\nconst text = buffer.toString('utf8');\n\n// split into one chunk per \"## \" section\nconst parts = text.split(/\\n(?=## )/);\nconst sections = [];\nfor (const part of parts) {\n  if (!part.startsWith('## ')) continue;\n  const title = part.split('\\n')[0].replace('## ', '').trim();\n  if (title.toLowerCase().startsWith('test questions')) continue;\n  sections.push({ json: { section: title, content: part.trim() } });\n}\nreturn sections;"
      },
