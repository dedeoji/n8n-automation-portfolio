      "name": "Cal.com booking"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst p = body.payload ?? {};\nif (body.triggerEvent !== 'BOOKING_CREATED') return [];\n\nconst wa = p.responses?.whatsapp;\nconst raw = typeof wa === 'object' && wa !== null ? (wa.value ?? '') : (wa ?? '');\nconst phone = String(raw).replace(/\\D/g, '');\nif (!phone) return [];\n\nconst when = new Date(p.startTime).toLocaleString('en-GB', {\n  timeZone: 'Europe/London',\n  weekday: 'long', day: 'numeric', month: 'long',\n  hour: 'numeric', minute: '2-digit', hour12: true\n});\n\nreturn [{ json: { phone, when, booking_id: p.uid ?? null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "648274fa-ba8b-4f56-8e9f-a1c897c9577d",
      "name": "Read booking"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update leads\nset status = 'booked', booked_at = now()\nwhere phone = $1 and opted_out = false\nreturning phone, first_name;",
        "options": {
          "queryReplacement": "={{ $json.phone }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
