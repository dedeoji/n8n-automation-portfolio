          "id": "",
          "name": "Postgres – Second Wind"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Read booking').first().json.phone }}",
        "textBody": "=Lovely, you're booked in{{ $json.first_name ? ', ' + $json.first_name : '' }}! 🎉 Your free call with Claire is on {{ $('Read booking').first().json.when }} (UK time). The Google Meet link is in your confirmation email. Grab a cuppa and we'll see you then 😊",
        "additionalFields": {}
