        "operation": "executeQuery",
        "query": "update leads\nset followup_sent_at = now()\nwhere opted_out = false\n  and followup_sent_at is null\n  and last_message_at > now() - interval '23 hours'\n  and (\n    (status = 'qualifying' and last_message_at < now() - interval '3 hours')\n    or (status = 'qualified' and last_message_at < now() - interval '20 hours')\n  )\n  and extract(hour from now() at time zone 'Europe/London') between 8 and 20\nreturning phone, first_name, status;",
        "options": {}
      },
