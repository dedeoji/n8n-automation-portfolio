    {
      "parameters": {
        "jsCode": "// Merge the new answers with what's already saved, then score (playbook rules)\nconst input = $('When Executed by Another Workflow').first().json;\nconst lead = $input.first().json;\n\nconst clean = v => (v === undefined || v === null || String(v).trim() === '' ? null : String(v).trim());\nconst pick = (v, allowed) => { v = clean(v); if (!v) return null; v = v.toLowerCase(); return allowed.includes(v) ? v : null; };\n\n// Health consent: only YES lets us keep health answers (UK GDPR)\nlet consent = clean(input.health_consent);\nconsent = consent === null ? lead.health_consent : /^(yes|y|true)$/i.test(consent);\n\nconst merged = {\n  first_name: clean(input.first_name) ?? lead.first_name,\n  health_consent: consent,\n  stage: consent === true ? (pick(input.stage, ['peri','post','not_sure','neither']) ?? lead.stage) : null,\n  goal: clean(input.goal) ?? lead.goal,\n  timing: pick(input.timing, ['this_month','1_3_months','just_looking']) ?? lead.timing,\n  budget: pick(input.budget, ['yes','payment_plan','not_now']) ?? lead.budget,\n};\n\nlet status = ['new'].includes(lead.status) ? 'qualifying' : lead.status;\nlet score = lead.score ?? null;\nlet next_step = 'continue';\nconst locked = ['handoff', 'booked'].includes(lead.status);\nconst complete = merged.stage && merged.goal && merged.timing && merged.budget;\n\nif (!locked && merged.health_consent === false) {\n  next_step = 'let_her_choose';\n} else if (!locked && merged.health_consent === true && complete) {\n  score = { peri: 2, post: 2, not_sure: 1, neither: 0 }[merged.stage]\n        + { this_month: 3, '1_3_months': 2, just_looking: 0 }[merged.timing]\n        + { yes: 3, payment_plan: 2, not_now: 0 }[merged.budget]\n        + (merged.goal ? 1 : 0);\n  if (merged.stage === 'neither') status = 'not_now';        // override 2\n  else if (merged.budget === 'not_now') status = 'nurture';  // override 1\n  else if (score >= 6) status = 'qualified';\n  else if (score >= 3) status = 'nurture';\n  else status = 'not_now';\n  next_step = { qualified: 'send_booking_link', nurture: 'invite_to_masterclass', not_now: 'share_facebook_group' }[status];\n}\n\nconst consent_at = merged.health_consent !== null && !lead.consent_at ? new Date().toISOString() : lead.consent_at;\nreturn [{ json: { phone: input.phone, ...merged, consent_at, score, status, next_step } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
