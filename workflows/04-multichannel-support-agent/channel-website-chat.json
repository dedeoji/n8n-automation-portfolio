      "parameters": {
        "jsCode": "// Voice note → text: put the transcript where a typed message would be, then continue as normal\nconst hook = $('Website Chat Webhook').first().json;\nconst text = String($json.text || '').trim();\nconst body = { ...hook.body, message: text ? `[Voice note] ${text}` : '', voice_note: true };\ndelete body.audio_base64;   // don't carry the audio further down the pipeline\nreturn [{ json: { headers: hook.headers, body } }];"
      },
