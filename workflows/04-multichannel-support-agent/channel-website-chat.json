    {
      "parameters": {
        "content": "## 🟢 Test 01 — Website Chat\nReceives messages from the Forgeline website chat widget (or the Channel Simulator).\n\n**Expected body:** `session_id`, `name`, `email`, `phone`, `message`, `page_url`\n\nOutputs the **Unified Message Schema v1** shared by every channel.\n\nTest URL → click *Listen for test event* first.\nProduction URL → activate the workflow.",
        "height": 284,
        "width": 460,
        "color": 4
      },
      "id": "86e4c0c3-4197-4f96-a976-449b46a28d11",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -880,
        160
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tillstone-webchat",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "096c4552-559f-4491-bbb9-366389c7f927",
      "name": "Website Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -848,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise Nigerian numbers to WhatsApp-style international format (e.g. 2348031234567)\nfunction normPhone(p) {\n  if (!p) return null;\n  let d = String(p).replace(/\\D/g, '');\n  if (d.startsWith('0') && d.length === 11) d = '234' + d.slice(1);\n  if (d.length === 10 && /^[789]/.test(d)) d = '234' + d;\n  return d || null;\n}\nfunction normEmail(e) {\n  if (!e) return null;\n  const s = String(e).trim().toLowerCase();\n  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(s) ? s : null;\n}\n// Our own unique ID for every message, whatever the channel: msg_<time>_<random>\nfunction newId() {\n  return 'msg_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);\n}\n\n// Website Chat -> Unified Message Schema (v2)\nreturn $input.all().map(item => {\n  const b = item.json.body ?? {};\n  const text = String(b.message ?? '').trim();\n  const email = normEmail(b.email);\n  const phone = normPhone(b.phone);\n  const missing = [];\n  if (!text) missing.push('message');\n  if (!b.session_id) missing.push('session_id');\n  if (!email && !phone) missing.push('email_or_phone');\n  return { json: {\n    schema_version: 2,\n    message_id: newId(),\n    channel_message_id: b.message_id || null,\n    channel: 'web_chat',\n    channel_user_id: b.session_id || null,\n    thread_id: b.session_id || null,\n    customer: { name: b.name ? String(b.name).trim() : null, email, phone, company: b.company ? String(b.company).trim() : null },\n    subject: null,\n    message_text: text,\n    message_type: 'text',\n    received_at: new Date().toISOString(),\n    is_valid: text.length > 0,\n    missing_fields: missing,\n    meta: {\n      page_url: b.page_url || null,\n      user_agent: item.json.headers?.['user-agent'] || null\n    }\n  }};\n});\n"
      },
