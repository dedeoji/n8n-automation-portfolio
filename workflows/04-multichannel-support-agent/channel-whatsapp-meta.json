    {
      "parameters": {
        "jsCode": "// Voice note → text: rewrite the incoming WhatsApp event as a normal text message with the transcript\nconst evt = JSON.parse(JSON.stringify($('WhatsApp Trigger').first().json));\nconst v = evt.body?.entry?.[0]?.changes?.[0]?.value ?? evt.entry?.[0]?.changes?.[0]?.value ?? evt;\nconst text = String($json.text || '').trim();\nconst m = v.messages[0];\nv.messages[0] = { from: m.from, id: m.id, timestamp: m.timestamp, type: 'text',\n                  text: { body: text ? `[Voice note] ${text}` : '' } };\nreturn [{ json: evt }];"
      },
      "id": "6e6467af-dbc8-41d7-82ac-4aea88ae6d9f",
      "name": "Merge Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise Nigerian numbers to WhatsApp-style international format (e.g. 2348031234567)\nfunction normPhone(p) {\n  if (!p) return null;\n  let d = String(p).replace(/\\D/g, '');\n  if (d.startsWith('0') && d.length === 11) d = '234' + d.slice(1);\n  if (d.length === 10 && /^[789]/.test(d)) d = '234' + d;\n  return d || null;\n}\nfunction normEmail(e) {\n  if (!e) return null;\n  const s = String(e).trim().toLowerCase();\n  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(s) ? s : null;\n}\n// Our own unique ID for every message, whatever the channel: msg_<time>_<random>\nfunction newId() {\n  return 'msg_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);\n}\n\n// WhatsApp (simulated Cloud API webhook OR n8n WhatsApp Trigger) -> Unified Message Schema (v2)\n// Works with both shapes, so swapping the Webhook for the real WhatsApp Trigger later needs no changes here.\nreturn $input.all().map(item => {\n  const j = item.json;\n  const v = j.body?.entry?.[0]?.changes?.[0]?.value\n         ?? j.entry?.[0]?.changes?.[0]?.value\n         ?? j;\n  const msg = v.messages?.[0];\n  const contact = v.contacts?.[0] ?? {};\n  if (!msg) {\n    // Delivery/read receipts arrive without a message - flag and let the IF node drop them\n    return { json: { schema_version: 2, channel: 'whatsapp', is_valid: false,\n      missing_fields: ['message'], note: 'status update, no customer message' } };\n  }\n  const phone = normPhone(msg.from || contact.wa_id);\n  let text = '';\n  if (msg.type === 'text') text = msg.text?.body ?? '';\n  else if (msg.type === 'button') text = msg.button?.text ?? '';\n  else if (msg.type === 'interactive') text = msg.interactive?.button_reply?.title ?? msg.interactive?.list_reply?.title ?? '';\n  else text = `[${msg.type} message]`;\n  text = String(text).trim();\n  const ts = Number(msg.timestamp);\n  return { json: {\n    schema_version: 2,\n    message_id: newId(),\n    channel_message_id: msg.id || null,\n    channel: 'whatsapp',\n    channel_user_id: phone,\n    thread_id: phone,\n    customer: { name: contact.profile?.name || null, email: null, phone },\n    subject: null,\n    message_text: text,\n    message_type: msg.type || 'text',\n    received_at: ts ? new Date(ts * 1000).toISOString() : new Date().toISOString(),\n    is_valid: text.length > 0 && !!phone,\n    missing_fields: [!text && 'message', !phone && 'phone'].filter(Boolean),\n    meta: { business_phone_id: v.metadata?.phone_number_id || null, simulated: !!j.body }\n  }};\n});"
      },
