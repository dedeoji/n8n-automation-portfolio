    {
      "parameters": {
        "jsCode": "// Phase 9 · Duplicate protection: the same channel message (same WhatsApp wamid / email Message-ID) is processed only once\nconst store = $getWorkflowStaticData('global');           // kept by n8n between production runs\nstore.seen = Array.isArray(store.seen) ? store.seen : [];\nreturn $input.all().map(item => {\n  const id = item.json.channel_message_id;\n  const is_duplicate = !!id && store.seen.includes(id);\n  if (id && !is_duplicate) {\n    store.seen.push(id);\n    if (store.seen.length > 1000) store.seen = store.seen.slice(-1000);   // remember the last 1,000\n  }\n  return { json: { ...item.json, is_duplicate } };\n});"
      },
