    {
      "parameters": {
        "jsCode": "// Normalise Nigerian numbers to WhatsApp-style international format (e.g. 2348031234567)\nfunction normPhone(p) {\n  if (!p) return null;\n  let d = String(p).replace(/\\D/g, '');\n  if (d.startsWith('0') && d.length === 11) d = '234' + d.slice(1);\n  if (d.length === 10 && /^[789]/.test(d)) d = '234' + d;\n  return d || null;\n}\nfunction normEmail(e) {\n  if (!e) return null;\n  const s = String(e).trim().toLowerCase();\n  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(s) ? s : null;\n}\n// Our own unique ID for every message, whatever the channel: msg_<time>_<random>\nfunction newId() {\n  return 'msg_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);\n}\n\n// Email (Gmail Trigger, Simplify = OFF) -> Unified Message Schema (v2)\nfunction stripQuoted(t) {\n  // Cut the quoted thread that mail clients append below a reply\n  const cut = t.search(/\\n\\s*On .{5,200}wrote:|\\n-{2,}\\s*Original Message|\\nFrom: .+\\nSent: /i);\n  return (cut > 0 ? t.slice(0, cut) : t).trim();\n}\nreturn $input.all().map(item => {\n  const j = item.json;\n  const from = j.from?.value?.[0] ?? {};\n  const raw = String(j.text ?? j.snippet ?? '');\n  const text = stripQuoted(raw);\n  const email = normEmail(from.address);\n  // Look for a phone number in the body so later phases can link the email to WhatsApp\n  const phoneMatch = raw.match(/(\\+?234|0)[789][01]\\d{8}/);\n  const missing = [];\n  if (!text) missing.push('message');\n  if (!email) missing.push('email');\n  return { json: {\n    schema_version: 2,\n    message_id: newId(),\n    channel_message_id: j.messageId || j.id || null,\n    channel: 'email',\n    channel_user_id: email,\n    thread_id: j.threadId || null,\n    customer: { name: from.name || null, email, phone: phoneMatch ? normPhone(phoneMatch[0]) : null },\n    subject: j.subject || null,\n    message_text: text,\n    message_type: 'text',\n    received_at: j.date ? new Date(j.date).toISOString() : new Date().toISOString(),\n    is_valid: text.length > 0 && !!email,\n    missing_fields: missing,\n    meta: { gmail_id: j.id || null, to: j.to?.text || null }\n  }};\n});\n"
      },
