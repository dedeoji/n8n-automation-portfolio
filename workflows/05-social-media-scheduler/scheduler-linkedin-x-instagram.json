      "parameters": {
        "jsCode": "// Turns calendar rows into one item per (post x platform) that is due right now.\nconst cfg = $('Config').first().json;\nconst tz = cfg.timezone || 'Africa/Lagos';\nconst now = DateTime.now().setZone(tz);\nconst maxLateHours = Number(cfg.maxLatenessHours ?? 48);\n\nconst LABELS = { linkedin: 'LinkedIn', x: 'X', instagram: 'Instagram' };\nconst ALIASES = { linkedin: 'linkedin', li: 'linkedin', x: 'x', twitter: 'x',\n                  instagram: 'instagram', ig: 'instagram', insta: 'instagram' };\nconst LIMITS = { linkedin: 3000, x: 280, instagram: 2200 };\nconst ROUTES = { linkedin_text: 0, linkedin_image: 1, x_text: 2, x_image: 3, instagram: 4, invalid: 5 };\n\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\n\nfunction parseTime(value) {\n  const s = clean(value);\n  if (!s) return null;\n  const formats = ['yyyy-MM-dd HH:mm', 'yyyy-MM-dd H:mm', 'yyyy-MM-dd HH:mm:ss',\n                   'd/M/yyyy HH:mm', 'd/M/yyyy H:mm', 'd/M/yyyy HH:mm:ss', 'yyyy-MM-dd'];\n  for (const f of formats) {\n    const d = DateTime.fromFormat(s, f, { zone: tz });\n    if (d.isValid) return d;\n  }\n  const iso = DateTime.fromISO(s, { zone: tz });\n  return iso.isValid ? iso : null;\n}\n\n// Google Drive share links -> direct download links\nfunction directMediaUrl(url) {\n  const m = url.match(/drive\\.google\\.com\\/(?:file\\/d\\/|open\\?id=|uc\\?(?:export=\\w+&)?id=)([\\w-]+)/);\n  return m ? `https://drive.google.com/uc?export=download&id=${m[1]}` : url;\n}\n\nfunction detectType(row, url) {\n  const t = clean(row['Media Type']).toLowerCase();\n  if (t === 'image' || t === 'video') return t;\n  if (!url) return 'none';\n  return /\\.(mp4|mov|m4v)(\\?|$)/i.test(url) ? 'video' : 'image';\n}\n\nconst out = [];\nfor (const { json: row } of $input.all()) {\n  const id = clean(row['ID']);\n  if (!id) continue;                                   // rows need an ID to be logged back\n  const approved = ['true', 'yes', 'y', '1'].includes(clean(row['Approved']).toLowerCase());\n  if (!approved) continue;                             // approval gate\n\n  const when = parseTime(row['Scheduled Time']);\n  if (when && when > now) continue;                    // not due yet\n\n  const rawMedia = clean(row['Media URL']);\n  const mediaUrl = rawMedia ? directMediaUrl(rawMedia) : '';\n  const mediaType = detectType(row, rawMedia);\n\n  const platforms = [...new Set(\n    clean(row['Platforms']).toLowerCase().split(/[,;\\/|]+/)\n      .map(p => ALIASES[p.trim()]).filter(Boolean)\n  )];\n\n  for (const platform of platforms) {\n    const label = LABELS[platform];\n    if (clean(row[`${label} Status`])) continue;       // already Posted or Failed on this platform\n\n    const caption = clean(row[`${label} Caption`]) || clean(row['Caption']);\n    let error = '';\n    if (!when) error = 'Scheduled Time is missing or not in yyyy-MM-dd HH:mm format';\n    else if (now.diff(when, 'hours').hours > maxLateHours)\n      error = `Missed the posting window (more than ${maxLateHours}h late). Set a new time and clear this status cell to retry`;\n    else if (!caption && mediaType === 'none') error = 'Nothing to post: caption and media are both empty';\n    else if (caption.length > LIMITS[platform]) error = `Caption is ${caption.length} characters; ${label} allows ${LIMITS[platform]}`;\n    else if (platform === 'instagram' && mediaType === 'none') error = 'Instagram needs an image or video URL';\n    else if (platform !== 'instagram' && mediaType === 'video')\n      error = `Video posting to ${label} isn't supported in this version. Use an image or text only`;\n\n    let route;\n    if (error) route = ROUTES.invalid;\n    else if (platform === 'instagram') route = ROUTES.instagram;\n    else route = ROUTES[`${platform}_${mediaType === 'image' ? 'image' : 'text'}`];\n\n    out.push({ json: {\n      id, rowNumber: row.row_number, platform, platformLabel: label,\n      caption, mediaUrl, mediaType,\n      scheduledFor: when ? when.toFormat('yyyy-MM-dd HH:mm') : '',\n      route, validationError: error,\n      igUserId: cfg.igUserId,\n      igPayload: mediaType === 'video'\n        ? { media_type: 'REELS', video_url: mediaUrl, caption }\n        : { image_url: mediaUrl, caption },\n    }});\n  }\n}\nreturn out;\n"
      },
