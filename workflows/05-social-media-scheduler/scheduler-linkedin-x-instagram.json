    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Shapes a successful publish into the columns to update in the sheet.\nconst src = $('Prepare Posts').item.json;\nconst tz = $('Config').first().json.timezone || 'Africa/Lagos';\nconst r = $json;\nlet ref = '';\nif (src.platform === 'linkedin') {\n  const urn = r.urn || r.id || '';\n  ref = urn ? `https://www.linkedin.com/feed/update/${urn}` : '';\n} else if (src.platform === 'x') {\n  const id = r.data && r.data.id;\n  ref = id ? `https://x.com/i/web/status/${id}` : '';\n} else {\n  ref = r.id ? `IG media ${r.id}` : '';\n}\nreturn { json: {\n  'ID': src.id,\n  [`${src.platformLabel} Status`]: 'Posted',\n  [`${src.platformLabel} Post`]: ref,\n  'Last Updated': DateTime.now().setZone(tz).toFormat('yyyy-MM-dd HH:mm'),\n}};\n"
      },
      "id": "42e9ca14-b579-4d97-86bb-f46d3a6ecead",
      "name": "Build Success Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        288
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Shapes any failure (validation, API error, Instagram processing) into sheet columns.\nconst src = $('Prepare Posts').item.json;\nconst tz = $('Config').first().json.timezone || 'Africa/Lagos';\nconst e = $json.error;\nlet msg = '';\nif (e) msg = typeof e === 'string' ? e : (e.description || e.message || JSON.stringify(e));\nif (!msg && $json.status_code) msg = `Instagram media processing ended with status ${$json.status_code} (ERROR = bad file or URL, IN_PROGRESS = timed out)`;\nif (!msg) msg = src.validationError || 'Unknown error';\nreturn { json: {\n  'ID': src.id,\n  [`${src.platformLabel} Status`]: 'Failed',\n  'Last Error': `${src.platformLabel}: ${String(msg).slice(0, 300)}`,\n  'Last Updated': DateTime.now().setZone(tz).toFormat('yyyy-MM-dd HH:mm'),\n}};\n"
      },
      "id": "9ee819a9-231f-4778-95b5-736f0e46710b",
      "name": "Build Failure Log",
