    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The job details, fetched from Prepare Posts\nconst src = $('Prepare Posts').item.json;\nconst tz = $('Config').first().json.timezone;\n\n// Work out the reason: an API error, or our own safety check\nconst e = $json.error;\nlet msg = '';\nif (e) msg = typeof e === 'string' ? e : (e.description || e.message || JSON.stringify(e));\nif (!msg && $json.status_code) msg = `Instagram processing ended with status ${$json.status_code}`;\nif (!msg) msg = src.validationError || 'Unknown error';\n\nreturn {\n  json: {\n    'ID': src.id,\n    [`${src.platformLabel} Status`]: 'Failed',\n    'Last Error': `${src.platformLabel}: ${String(msg).slice(0, 300)}`,\n    'Last Updated': DateTime.now().setZone(tz).toFormat('yyyy-MM-dd HH:mm'),\n  }\n};"
      },
