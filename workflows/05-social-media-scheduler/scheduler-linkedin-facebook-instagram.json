    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Prepare Posts').item.json;\nconst tz = $('Config').first().json.timezone;\nconst r = $json;\n\n// Each platform replies differently, so build the link to match\nlet link = '';\nif (src.platform === 'linkedin') {\n  const urn = r.urn || r.id || '';\n  link = urn ? `https://www.linkedin.com/feed/update/${urn}` : '';\n} else if (src.platform === 'facebook') {\n  const postId = r.post_id || r.id || '';\n  link = postId ? `https://www.facebook.com/${postId}` : '';\n} else if (src.platform === 'instagram') {\n  link = r.id ? `Instagram media ${r.id}` : '';\n}\n\nreturn {\n  json: {\n    'ID': src.id,\n    [`${src.platformLabel} Status`]: 'Posted',\n    [`${src.platformLabel} Post`]: link,\n    'Last Updated': DateTime.now().setZone(tz).toFormat('yyyy-MM-dd HH:mm'),\n  }\n};"
      },
