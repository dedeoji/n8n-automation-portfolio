    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst tz = cfg.timezone;\nconst now = DateTime.now().setZone(tz);\nconst maxLateHours = Number(cfg.maxLatenessHours ?? 48);\n\nconst ALIASES = { linkedin: 'linkedin', li: 'linkedin',\n                  facebook: 'facebook', fb: 'facebook',\n                  instagram: 'instagram', ig: 'instagram', insta: 'instagram' };\nconst LABELS = { linkedin: 'LinkedIn', facebook: 'Facebook', instagram: 'Instagram' };\nconst LIMITS = { linkedin: 3000, facebook: 63206, instagram: 2200 };\nconst ROUTES = { linkedin_text: 0, linkedin_image: 1,\n                 facebook_text: 2, facebook_image: 3,\n                 instagram: 4, invalid: 5 };\n\nfunction directMediaUrl(url) {\n  const m = url.match(/drive\\.google\\.com\\/(?:file\\/d\\/|open\\?id=|uc\\?(?:export=\\w+&)?id=)([\\w-]+)/);\n  return m ? `https://drive.google.com/uc?export=download&id=${m[1]}` : url;\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const id = String(row['ID'] || '').trim();\n  if (!id) continue;\n\n  const approved = String(row['Approved']).trim().toUpperCase() === 'TRUE';\n  if (!approved) continue;\n\n  const when = DateTime.fromFormat(\n    String(row['Scheduled Time'] || '').trim(), 'yyyy-MM-dd HH:mm', { zone: tz });\n  if (when.isValid && when > now) continue;\n\n  const rawMedia = String(row['Media URL'] || '').trim();\n  const mediaUrl = rawMedia ? directMediaUrl(rawMedia) : '';\n  let mediaType = String(row['Media Type'] || '').trim().toLowerCase();\n  if (mediaType !== 'image' && mediaType !== 'video') {\n    mediaType = !rawMedia ? 'none' : /\\.(mp4|mov|m4v)(\\?|$)/i.test(rawMedia) ? 'video' : 'image';\n  }\n\n  const platforms = [...new Set(\n    String(row['Platforms'] || '').toLowerCase().split(',')\n      .map(p => ALIASES[p.trim()]).filter(Boolean)\n  )];\n\n  for (const platform of platforms) {\n    const label = LABELS[platform];\n    if (String(row[`${label} Status`] || '').trim()) continue;\n\n    const caption = String(row[`${label} Caption`] || row['Caption'] || '').trim();\n\n    let error = '';\n    if (!when.isValid)\n      error = 'Scheduled Time is missing or not in yyyy-MM-dd HH:mm format';\n    else if (now.diff(when, 'hours').hours > maxLateHours)\n      error = `More than ${maxLateHours}h late. Set a new time and clear the Status cell to retry`;\n    else if (!caption && mediaType === 'none')\n      error = 'Nothing to post: caption and media are both empty';\n    else if (caption.length > LIMITS[platform])\n      error = `Caption is ${caption.length} characters; ${label} allows ${LIMITS[platform]}`;\n    else if (platform === 'instagram' && mediaType === 'none')\n      error = 'Instagram needs an image or video URL';\n    else if (platform !== 'instagram' && mediaType === 'video')\n      error = `Video to ${label} isn't supported yet. Use an image or text only`;\n\n    let route;\n    if (error) route = ROUTES.invalid;\n    else if (platform === 'instagram') route = ROUTES.instagram;\n    else route = ROUTES[`${platform}_${mediaType === 'image' ? 'image' : 'text'}`];\n\n    out.push({\n      json: {\n        id, platform, platformLabel: label, caption, mediaUrl, mediaType,\n        scheduledFor: when.isValid ? when.toFormat('yyyy-MM-dd HH:mm') : '',\n        route, validationError: error,\n                        igPayload: (() => {\n          const m = rawMedia.match(/drive\\.google\\.com\\/(?:file\\/d\\/|open\\?id=|uc\\?(?:export=\\w+&)?id=)([\\w-]+)/);\n          const igUrl = m ? `https://lh3.googleusercontent.com/d/${m[1]}` : mediaUrl;\n          return mediaType === 'video'\n            ? { media_type: 'REELS', video_url: igUrl, caption }\n            : { image_url: igUrl, caption };\n        })(),\n      }\n    });\n  }\n}\n\nreturn out;"
      },
