    {
      "parameters": {
        "jsCode": "const b = $('Build Prompt').first().json;\nconst tz = $('Config').first().json.timezone;\n\n// 1. Get the AI's answer (works whether it arrives as text or as data)\nconst j = $json;\nlet raw = j.output?.[0]?.content?.[0]?.text ?? j.message?.content ?? j.text ?? j;\nconst data = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst posts = (data.posts || []).slice(0, b.n);\nif (!posts.length) throw new Error('The AI returned no posts');\n\n// 2. One post per day, at the coach's posting time\nconst [hour, minute] = String(b.postingTime).split(':').map(Number);\nconst start = DateTime.fromISO(String(b.firstDate).slice(0, 10), { zone: tz })\n  .set({ hour, minute, second: 0 });\nconst stamp = DateTime.now().setZone(tz).toFormat('yyMMddHHmm');\n\n// 3. Shape each post into a Calendar row\nreturn posts.map((p, i) => ({\n  json: {\n    'ID': `R${stamp}-${i + 1}`,\n    'Scheduled Time': start.plus({ days: i }).toFormat('yyyy-MM-dd HH:mm'),\n    'Platforms': b.platforms,\n    'Caption': p.linkedin,\n    'LinkedIn Caption': p.linkedin,\n    'Facebook Caption': p.facebook,\n    'Instagram Caption': p.instagram,\n    'Approved': 'FALSE',\n    'Source': `${b.title} · ${p.angle}`,\n  }\n}));"
      },
